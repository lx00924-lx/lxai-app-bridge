{
  "name": "lxai-app-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Local HTTP bridge plugin for a local agent host: model catalog, session list with real model/effort/permission state, SSE agent turns, choice-box (ask_user_question) relay, approval relay and abort — used by the LxAI App remote bridge.",
  "keywords": [
    "agent",
    "local-agent",
    "rest",
    "sse",
    "openai-compatible",
    "plugin",
    "bridge",
    "remote-control"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lx00924-lx/lxai-app-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/lx00924-lx/lxai-app-bridge/issues"
  },
  "author": "lx00924-lx",
  "homepage": "https://github.com/lx00924-lx/flutter-app",
  "license": "AGPL-3.0-only",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
